{
  "name": "caresync",
  "version": "1.0.0",
  "private": true,
  "description": "Clinic care-coordination dashboard: Next.js, TypeScript and Firebase (Auth + Firestore real-time)",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:rules": "firebase emulators:exec --only firestore --project demo-caresync \"vitest run --config vitest.rules.config.ts\"",
    "emulators": "firebase emulators:start --project demo-caresync",
    "seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "3.9.1",
    "clsx": "2.1.1",
    "firebase": "11.1.0",
    "next": "14.2.18",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-hook-form": "7.54.1",
    "zod": "3.23.8",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "4.0.1",
    "@types/node": "20.17.10",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "autoprefixer": "10.4.20",
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.18",
    "firebase-admin": "13.0.2",
    "firebase-tools": "13.29.1",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.6.3",
    "vitest": "2.1.8"
  }
}
